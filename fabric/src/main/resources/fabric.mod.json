{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		{
			"name": "${mod_author}",
			"contact": {
				"homepage": "https://modrinth.com/user/${mod_author}"
			}
		}
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/${mod_id_slug}",
		"sources": "${mod_sources}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/dayz_inventory/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.suoim.dayzinventory.fabric.DayZInventoryFabric"
		],
		"client": [
			"com.suoim.dayzinventory.fabric.client.DayZInventoryFabricClient"
		]
	},
	"mixins": [
		"dayz-inventory.mixins.json",
		{
			"config": "dayz-inventory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${fabric_loader_range}",
		"minecraft": "${minecraft_range_fabric}",
		"java": "${java_range_fabric}",
		"fabric-api": "${fabric_api_range}"
	},
	"suggests": {
		"jei": "*",
		"roughlyenoughitems": "*",
		"emi": "*",
		"trinkets": "*",
		"curios": "*"
	}
}
