{
	"schemaVersion": 1,
	"id": "dayz_inventory",
	"version": "${version}",
	"name": "DayZ Inventory",
	"description": "A complete overhaul of the Minecraft inventory UI, bringing the look, feel, and mechanics of the DayZ inventory system into Minecraft.",
	"authors": [
		{
			"name": "suoim",
			"contact": {
				"homepage": "https://modrinth.com/user/suoim"
			}
		}
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/dayz-inventory",
		"sources": "https://github.com/aacanadaa/DayZ-Inventory",
		"issues": "https://github.com/aacanadaa/DayZ-Inventory/issues"
	},
	"license": "Apache-2.0",
	"icon": "assets/dayz_inventory/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.suoim.dayzinventory.fabric.DayZInventoryFabric"
		],
		"client": [
			"com.suoim.dayzinventory.fabric.client.DayZInventoryFabricClient"
		]
	},
	"mixins": [
		"dayz-inventory.mixins.json",
		{
			"config": "dayz-inventory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"jei": "*",
		"roughlyenoughitems": "*",
		"emi": "*",
		"trinkets": "*",
		"curios": "*"
	}
}
